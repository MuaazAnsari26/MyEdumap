# ---------- Server ----------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/edumap

# ---------- JWT ----------
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# Short-lived token used only for email verification links
EMAIL_VERIFICATION_SECRET=replace_with_another_long_random_string
EMAIL_VERIFICATION_EXPIRES_IN=1d

# ---------- Email (Nodemailer / SMTP) ----------
# Works with a Gmail App Password, or any SMTP provider (Resend, SendGrid SMTP, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="EduMap <no-reply@edumap.app>"

# ---------- AI Provider (used by the quiz generation engine) ----------
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Set this to whatever Gemini model your API key has access to.
GEMINI_MODEL=gemini-3.6-flash

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
